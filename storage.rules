rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Explicitly deny any profile picture uploads
    match /profile_pictures/{allPaths=**} {
      allow read, write: if false;
    }
    match /profiles/{allPaths=**} {
      allow read, write: if false;
    }
    match /avatars/{allPaths=**} {
      allow read, write: if false;
    }

    // Camps / public assets
    match /camps/{campId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default: allow read for authenticated, restrict write to admins
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
